---
import { getCollection } from 'astro:content';
import BaseHead from '@/components/layout/BaseHead.astro';
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import EventsApp from '@/components/events/EventsApp.tsx';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts.ts';

const events = (await getCollection('events')).sort(
	(a, b) => b.data.eventDateStart.valueOf() - a.data.eventDateStart.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} - Events`} description={`${SITE_DESCRIPTION} - Upcoming and past events`} />
	</head>
	<body class="events-page">
		<Header />
		
		<!-- Hero Section - Clean & Modern -->
		<header class="page-hero">
			<div class="page-hero-container">
				<div class="page-hero-content">
					<h1 class="page-hero-title">
						Events & Programs
					</h1>
					<p class="page-hero-description">
						Stay plugged into upcoming workshops, showcases, and happenings that power UC San Diego's HDSI Lab 3.0 community.
					</p>
				</div>
			</div>
		</header>

		<main id="main-content" class="events-page-main" tabindex="-1">
			<div class="page-content-wrapper">
				<EventsApp client:load events={events} />
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-hero {
		background: linear-gradient(180deg, #fafbfc 0%, #ffffff 100%);
		border-bottom: 1px solid #e8ecf0;
		padding: 3rem 1.5rem 2rem;
	}

	.page-hero-container {
		max-width: 1400px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.page-hero-content {
		text-align: center;
		max-width: 640px;
		margin: 0 auto;
	}

	.page-hero-label {
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #059669;
		background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
		padding: 0.375rem 0.875rem;
		border-radius: 9999px;
		margin-bottom: 1rem;
	}

	.page-hero-title {
		font-size: 2.5rem;
		font-weight: 700;
		color: #0f172a;
		line-height: 1.15;
		margin-bottom: 0.75rem;
		letter-spacing: -0.025em;
	}

	.page-hero-description {
		font-size: 1.125rem;
		color: #475569;
		line-height: 1.6;
	}

	.page-content-wrapper {
		max-width: 1400px;
		margin: 0 auto;
		padding: 2rem 1.5rem 3rem;
	}

	@media (max-width: 640px) {
		.page-hero {
			padding: 2rem 1rem 1.5rem;
		}

		.page-hero-title {
			font-size: 1.875rem;
		}

		.page-hero-description {
			font-size: 1rem;
		}

		.page-content-wrapper {
			padding: 1.5rem 1rem 2rem;
		}
	}
</style>
