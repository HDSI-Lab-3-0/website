---
import BaseHead from '../components/layout/BaseHead.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import "../styles/global.css";
import { SITE_DESCRIPTION } from '../consts.ts';

const interestFormUrl = "https://forms.gle/ZJpHG1mCB6ShiYJy9";
---

<html lang="en">
  <head>
    <BaseHead title="Contact" description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />

    <main id="main-content" class="constrained-main" tabindex="-1">
      <div class="content-page">
        <header class="page-header">
          <h1>Contact</h1>
          <p class="page-description">
            Would you like to be added to our mailing list? Or do you have a comment or question? Fill out the form below.
          </p>
        </header>

        <div class="contact-actions">
          <a
            href={interestFormUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="contact-button"
          >
            Fill Out Interest Form
          </a>
        </div>
      </div>
    </main>

    <Footer />

    <style>
      .contact-actions {
        margin-top: 2rem;
        text-align: center;
      }

      .contact-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 3.25rem;
        padding: 0.875rem 1.75rem;
        background-color: rgb(37, 99, 235);
        color: white;
        text-decoration: none;
        border-radius: 0.5rem;
        font-weight: 700;
        font-size: 1rem;
        transition: background-color 0.2s, transform 0.2s;
      }

      .contact-button:hover {
        background-color: rgb(29, 78, 216);
        transform: translateY(-1px);
      }
    </style>
  </body>
</html>
